{
  "name": "sul-storefront",
  "private": true,
  "type": "module",
  "scripts": {
    "bundle": "esbuild src/motion.js src/world.js --bundle --minify --format=esm --target=es2022 --outdir=assets",
    "build": "npm run bundle && node scripts/stripe-links.mjs --build && node scripts/build.mjs",
    "stripe": "node scripts/stripe-links.mjs",
    "dev": "python3 -m http.server 4173 --bind 127.0.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "lenis": "^1.3.27",
    "three": "^0.187.0"
  }
}
